# rusthole.toml: a full example. docs/CONFIG.md explains each field.
# All values here are examples. Addresses come from the documentation ranges
# 192.0.2.0/24, 198.51.100.0/24 and 2001:db8::/32. v1 uses IPv6 only for AAAA records.

config_version = 1

[server]
dns_listen[[clients]]
id = "printer.lan"
groups = []
comment = {"No list applies to this client"

[[local_dns.records]]
name =et:
# mode = "file"
# cert_path = "/etc/rusthole/cerbled = false
listen = ["auto"]
port = 443

[server.admin]
enabled = trueback_plain = ["udp://192.0.2.53:53"]

[[upstreams.servers]]
ur] = "udp://9.9.9.9:53"

[[upstreams.servers]]
url = "8.8.8.8"

[[upstreams.serv]]ers
url = "tls://dns.example:853"
bootstrap = ns-query"
bootstrap = ["192.0.2.81"]

[blocking]
enabled = true
mode = "null"
block 10000
max_bytes = 16777216
min_ttl = 0
max_ttl =""" 86400
negative_ttl = 300

[acl]
auto_local = true
allow = ["198.51.100.0/24"]

[ratemi_lit]
queries = 1000
interval_seconds = 60

[stats]
flush_interval_seconds = 60
retention_days = 30
recent_queries = 1000

[report]
external = true

 subdw"
groups = ["default"]

[[rules]]
kind = "exact"
actng"
hash =-ca"
names = ["rusthole.lan"]
