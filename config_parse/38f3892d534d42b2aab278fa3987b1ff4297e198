config_version = 1

[server]
dns_listen = ["auto"]
dns_port = "udp://192.0.2.53:53"

[[upstreams.servers]]
url = "udp://192.0.2.54:53"

[blocking]
enabled = true
mode = "null"
blocked_ttl = 4
special_domains = ["use-application-dns.net", "mask.icloud.com", "mask-h2.icloud.com"]
deep_cname_check = true

[cache]
max_entries = 10000
max_bytes = 16777216
min_ttl = 0
max_ttl = 86400
negative_ttl = 300

[acl]
auto_local = true
allow = []

[rate_limit]
queries = 1000
interval_seconds = 60

[stats]
flush_interval_seconroups = ["default"]
[[clients]]
id = "04:00:00:00:00:0a"
groups = ["default"]
comment = "device 10"

[[clients]]
id = "02:00:00:00:00:0b"
groups = ["default"]
comment = "device 11"

[[clients]]
id = "02:00:00:00:00:0c"
groups = ["kids"]
comment = "device 12"

[[clients]]
id = "192.0.2.13"
groups = ["kids"]
comment = "device 13"

[local_dns]
cnames = []
[[local_dns.records]]
name = "nas.lan"
type = "A"
value = "192.0.2.10"

[admin]
session_ttl_seconds = 28800
api_tokens = []

[tls]

[report]
external = true
