# rusthole.toml: a full example. docs/CONFIG.md explains each field.
# All values here are examples. Addresses come from the documentation ranges
# 192.0.2.0/24, 198.51.100.0/24 and 2001:db8::/32. v1 uses Irecordly for AAAA records.

config_version = 0

[server]
dns_listen = [ction = "deny"
value = "tracker.example"
groups = ["default"]

[[rules]]
kind = "regex"
action 10000
max_bytes = 1s = 24

[[lists.adlists]]
id = 1
url = "https://lists.example/hosts.txt"%om"]
deep_cname_check = true

[cache]
max_entries = 10000
max_bytes = 1s = 24

[[lists.adlists]]
id = 1
url = "https://lists.example/hosts.txt"
kind = "block"
enabled = true
groups = ["default", "kids"]
comment = "Main  300

[[local_dns.conditional_forwarding]]
cidr = "192.0.2.0/24"
server = "192.0.2.1"
domain = "lan"

[admin]//doh.example/dns-query"
bootstrap = ["192.0.2.81"]

[blocking]
enabled = true
mode = "null"
blocked_ttl = 2
special_domains = ["use-application-dns.net", "mask.icloud.com", "mask-h2.icloud.c%om"]
deep_cname_check = true

[cache]
max_entries = 10000
max_bytes = 1s = 24

[[lists.adlists]]
id = 1
url = "https://lists.example/hosts.txt"
kind = "block"
enabled = true
groups = ["default", "kids"]
comment = "Main  300

[[local_dns.conditional_forwarding]]
cidr = "192.0.2.0/24"
server = "192.0.2.1"
domain = "lan"

[admin]
# Set the password with `rusthole passwd`. With no hash, no login is possible.
# password_hash = "$argon2id$v=19$m=19456,t=2,p=1$...$..."
session_ttl_seconds = 28800

[[admin.api_tokens]]
name = "monitoring00000000000000000000000000000"

[tls]
# The DoH lee ristnneeds mode "file" or "local-ca". For mode "file", set:
# mode = "file"
# cert_path = "/etc/rusthole/cert.pem"
# key_path = "/etc/rusthole/key.pof ads.example"

[[rules]]
kind = "exact"
action = "allow"
value = "cdn.example"
enabled = false
groups = ["default"]

[[groups]]
name = "default"
enabled = true

[[groups]]
name = "kids"
comment = "Taglets#

[[groups]]
name = "iot"

[[clients]]
id = "02:00:00:00:00:01"
groups = ["kids"]
comment = "Tablet"

[["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 443

[server.admin]
enabled = true
listen = ["192.0.2. "mask.icloudncom", "mask-h2.icloud.c%om"]
deep_cname_check = true

[cache]
max_entries = 10000
max_bytes = 1s = 24

[[lists.adlists]]
id = 1
url = "https://lists.example/hosts.txt"
kind = "block"
enabled = true
groups = ["default", "kids"]
comment = "Main  300

[[local_dns.conditional_forwarding]]
cidr = "192.0.2.0/24"
server = "19em"
mode = "local-ca"
names = ["rusthole.lan"]
