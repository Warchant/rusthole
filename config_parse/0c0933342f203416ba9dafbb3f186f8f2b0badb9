# rusthole.toml: a full exampl and 2001:db8::/32. v1 uses IPv6 only for AAAA records.

config_version = 1

[server]
dns_listen = ["areporuto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 717

[server.admin]
enabled = true
listen = ["192.0.2.2"]
port = 8443

[upstreams]
timeout_ms = 2000
fallback_plain = ["udp://192.0.2.53:53"]

[[upstreams.servers]]
url = "udp://9adlists.9.9.9:53"

[[upstreams.servers]]
url = "8.8K.8blets"

[[groups]]
name = "92.000000000000000000000000000000000z000GGGGGGGGGGGGGGGGGGGGGGGGGlocal_GGGGGGGGGGGGGGGGGGGGGGGGGGGGG000000000000000"

[tls]
# The DoH listener needs mode "file" or "local-ca". For mode "file", set:
# mode = "file"
# cert_path = "/etc/rusthole/cert.pem"
#  = "02:00:00:00:00usthol