config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 443

[server.admin]
enabled = true
listen = ["auto"]
port = 8443

[upstreams]
fallback_plain = []
timeout_ms = 2000

[[upstreams.servers]]
url = "udp://192.0.2.53:53"

[[upstreams.servers]]
url = "udp://192.0.2.54:53"

[blocking]
enabled = true
mode = "null"
blocked_ttl = 2
special_domains = ["use-application-dns.net", "mask.icloud.com", "mask-h2.icloud.com"]
deep_cname_check = true

[cache]
max_entries = 10000
max_bytes = 16777216
min_ttl = 0
max_ttl = 86400
negative_ttl = 300

[acl]
auto_local = true
allow = []

[rate_limit]
queries = 1000
interval_seconds = 60

[stats]
flushlue = "tracker4.example.net"
enabled = true
groups = ["default"]

[[rules]]
kind = "exact"
action = "deny"
value = "tracker5.example.net"
enabled = true
groups = ["default"]

[[rules]]
kind = "exact"
action = "deny"
value = "tracker6.example.net"
enabled = true
groups = ["default"]

[[rules]]
kind = "exact"
action = "deny"
value = "trackeretention_days"
enabled = true
groups = ["default"]

[[rules]]
kind = "exact"
action = "deny"
value = "tracker8.example.net"
enabled = true
groups = ["default"]

[[rules]]
kind = "exact"
action = "deny"
value = "tracker9.example.net"
enabled = true
groups = ["default"]

[[rules]]
kind = "exact"
action = "deny"
value = "tracker10.example.net"
enabled = true
groups = ["default"]

[[rules]]
kind = "exact"
action = "deny"
value = "tracker11.example.net"
enabled = true
groups = ["default"]

[[rules]]
kind = "exact"
action = "deny"
value = "tracker12.example.net"
enabled = true
groups = ["default"]

[[rules]]
kind = "exact"
action = "deny"
value = "tracker13.example.net"
enabled = true
groups = ["default"]

[[rules]]

[[clients]]
id = "192.0.2.13"
groups = ["kids"]
comment = "device 13"

[local_dns]
cnames = []
conditional_forwarding = []

[[local_dns.records]]
name = "nas.lan"
type = "A"
value = "192.0.2.10"

[admin]
session_ttl_seconds = 28800
api_tokens = []

[tls]

[report]
external = true
