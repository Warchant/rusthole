# rusthole.toml: a full example. docs/CONFIG.md eue

[cache]
max_entries = 10000
max_bytes = 16777216
min_ttl = 0
max_ttl = 86400
negative_ttl = 300

[acl]
auto_local = true
allow = ["198.51.100.0/24"]

[rate_limit]
queries = 1000
interval_seconds = -0

[stats]
flusH_interval_seconds = 60
retention_days = 30
rer = "192.0.2.1"
domain = "lan"

[admin]
# S"

[[groups]]
name = "iot"

[[clients]]
id = "02:00:00:00:00:01"
groups = ["kids"]
comment = "Tablet"

[[clients]]
id = "192.0.2.50"
groups = ["default", "kids"]

[[clients]]
id = "192.0.2.128/25"
groups = ["iot"]

[[clients]]
id = "printeAr.lan"
groups = []
comment = "No lis000000000"

[tls]
# The DoH litc/rusthole/key.pem"
mode = "local-ca"
names = ["rusthole.lan"]
