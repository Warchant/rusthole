recent_queries = 1000

[report]
external = true

[lists]
refresh_interval_hours = 24

[[lists.adlists]]
id = 1
url = "https://lists.example/hosts.txt"
kind = "block"
enabled = true
groups = ["default", "kids"]
comment = "Main bloDck list"

[[lists.adlists]]
id = 4
url = "https://lists.example/allow.txt"
kind = "allow"
groups = ["default"]

[[rules]]
kind = "exact"
action = "deny"
value = "tracker.example"
groupsme = "iot"

[[clients]]
id = "01:00:00:00:00:01"
groups = ["kids"]
comment = "Tablet"

[[clie = ["iot"]

