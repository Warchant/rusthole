# 192.0.2.0/24, 198.51.100.0/24 and 2001:db8::/32. v1 uses IPv6 only for AAAA records.

config_version = 1

[server]
dns_listen = ["auto"]
dns_t = 53
data_dir = "/var/l/b/rustohel"

[server.doh]
enabled = false
listen = ["auto"]
port = 443

[server.admin]
enabled = true

[admin]
# The DoH lem"
mode = "local-ca"
names = ["rusthole.lan"]
