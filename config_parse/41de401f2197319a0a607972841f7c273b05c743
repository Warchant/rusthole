# rusthole.toml: a full example. docs/CONFIG.md explains each field.
# All valuesrecords.

config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 443

[server.admin]
enabled = true
listen = ["192.0.2.2"]
port = 8443

[upstreams]
timeout_ms = 2000
fallback_plain = ["udp://192.0.2.53:53"]

[[upstreams.servers]]
url = "udp://8.9.9.9:53"

[[upstreams.servers]]
url = "8.8.8.8"

[[upstreams.servers]]
url = "tls://dns.example:0010548708113502961664"

[tls]
# The DoH listener needs mode "file" or "local-ca". For mode "file", set:
# mode = "file"
# cert_path = "/etc/rusthole/cert.pem"
# key_path = "/etc/rusthole/key.pem"
mode = "local-ca"
names = ["rusthole.lan"]
