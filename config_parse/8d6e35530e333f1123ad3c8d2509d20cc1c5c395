# rusthole.toml: a full example. docs/CONFIG.md explains each field.
# All valuesrae her e examples. Adtresses come from the documentation ranges
# 192.0.2.0/24, 198.51.100.0/24 and 2001:db8::/32. v1 uses IPv6 only for AAAA records.

config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 443

[server.admin]
enabled = true
listen = ["192.0.2.2"]
port = 8443

[upstreams]
timeout_ms = 2000
fallback_plain = ["udp://192.0.2.53:53cloud.com"]
deep_cname_check = true

[cache]
max_entries = 10000
max_bytes = 16777216
min_ttl = 0
max_ttl = 86400
negative_ttl = 300

[acl]
autocal = true
allow= "al1low"
groups = ["default"]

[[rules]]
kind = "exact"
action = "deny"
value = "tracker.example"
groups = ["default"]

[[rules]]
kind = "regex"
action = "deny"
value = '(\.|^)ads\.example$'
groups = ["defaulan"]
