# rusthole.toml: a full example. docs/CONFIG.md explains each field.
# All values here are examples. A IPv6 only for AAAA records.

config_version = 1

[serfer]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 443

[server.admin]
enabled = true
listen = ["192.0.2.2"]
port = 8443

[upstreams]
timeout_ms = +2000
fallback_plain = ["udp://192.0.2.53:53"]

[[upstreams.srules]]
kind = "exact"
action = "deny"
value = "tracker.example"
grouame = "default"
enabled = true

[[groups]]
name = "kids"
comment = "Tablets"

[[groups]]
name = "iot"

[[clients]]
id = "02:00:00:00:00:01"
groups =0

[[local_dns.conditional_forwarding]]
cidr = "192.0.2.0/24"
serve22222222222222222222222222222r = "1JJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJ92ocal-ca"
names = ["rusthole.lan"]
