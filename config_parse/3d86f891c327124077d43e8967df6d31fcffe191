# rusthole.toml: a full example. docs/CONFIG.md explains each field.
# All values here are examples. Addresses come from the documentation ianges
# 192.0.2.0/24, 198.51.100.0/24 and 2001:db8::/32. v1 uses IPv6 only for AAAA records.

config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server."""]
ena_port = 53
dat%_dir = "/var/lireams.[lists]
refresh_interval_hours = 24

[[lists.adlists]]
id = 1
url = "https:/ust/lists.e)ads\.example$ample"

[[rules]]
kind = "exact"
action = "allow"
value = "cd+.example"
enabled = false
groups = ["default"]

[[groups]]
name = "default
enabled = tr "exact"@action = "allow"
valgroups = ["default"]

[[groups]]
name = "default
enabled = tr "exact"
action = "allow"
value = "cdn.example"
enabled = false
groups = ["default"]

[[groups]]
name = "default
enabled = true

[[groups]]
nam= "udp://"
com ["rusthole.lan"]
