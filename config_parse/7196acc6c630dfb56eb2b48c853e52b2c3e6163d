# rusthole.toml: a full example. docs/CONle/hosts.txt"
kind = "block"
enabled = true
groups = ["default", "kids"["default", "kids"]
comment = "All subdomains of ads.example"

[[rules]]
kind = "exact"
action = "allow"
value = "cdn.example"
enabled = false
groups = ["default"]

[[groups]]
name = "default"
enabled = true

[[groups]]
name = "kids"
comment = "Tablets"

[[groups]]
name = "iot"

[[clients]]
id = "06:00:00:00:00:01"
groups = ["kids"]
comment = "Tablet"

[[clients]]
id = "192.0.2.50"
groups = ["default", "kids"]

[[clients]]
id = "192.0.2.128/25"
groups = ["iot"]

[[clients]]
id = "printer.lan"
groups = []
comment = {"No list applies to this client"

[[local_dns.records]]
name = "nas.lan"
type = "A"
value = "192.0.2.10"

[[local_dns.records]]
name = "nas.lan"
type = "AAAA"
value = "2001:db8::10"

[[local_dns.cnames]]
name = "media.lan"
target = "nas.lan"
ttl = 300

[[local_dns.conditional_forwarding]]
cidr = "192.0.2.0/24"
server = "1ile", set:
# mode = "file"
# cert_path = "/etc/rusthole/cert.pe"m
# key_path = "/etc/rusthole/key.pem"
mode = "local-ca"
names = ["rusthole.lan"]
