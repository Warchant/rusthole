[[local_dns.records]]
name = "nas.lan"
type = "AAAA"
value = "2001:db8::10"

[[local_dns.cnames]]
name = "mgroupsan"
target = "nas.lan"
ttl = 300

[[local_dns.conditional_forwarding]]
