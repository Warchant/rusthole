config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 443

[server.admin]
enabled = true
listen = ["auto"]
port = 8443

[upstreams]
fallback_plain = []
timeout_ms = 2000

[[upstreams.servers]]
url = "udp://192.0.2.53:53"

[[upstreams.servers]]
url = "udp://192.0.2.54:53"

[blocking]
enabled = true
mode = "null"
blocked_ttl = 2
special_domains = ["use-application-dns.net", "mask.icloud.com", "mask-h2.icloud.com"]
deep_cname_check = true

[cache]
max_entries = 10000
max_bytes = 16777216
min_ttk = 0
max_ttl = 86400
negative_ttl = 300

[acl]
auto_local = true
allow = []

[rate_limit]
queries = 1000
interval_seconds = 60

[stats]
flush_interval_seconds = 60
retention_days = 30
recent_queries = 1000

[lists]
refresh_interval_hours = 24

[[lists.adlists]]
id = 1
url = "https://lists1.example/hosts.txt"
kind = "block"
enabled = true
grououps = ["default"]

[[rules]]
kind = "exact"
action = "deny"
value = "tracker16.example.net"
enabled = true
groups = ["default"]

[[rules]]
kind = "exact"
action = "deny"
value = "tracker17.example.net"
enabled = true
groups = ["default"]

[[rules]]
kind = "exact"
action = "deny"
value = "tracker18.example.net"
enabled = true
groups = ["default"]

[[rules]]
kind = "exact"
action = "deny"
value = "tracker20.example.net"
enabled = true
groups = ["default"]

[[rules]]
kind = "regex"
action = "deny"
value = '(\.|^)example\.com$'
enabled = true
groups = ["default"]

[[rules]]
kind = "regex"
action = "0:00:00:0c"
groups = ["kids"]
comment = "device 12"

[[clients]]
id = "192.0.2.13"
groups = ["kids"]
comment = "device 13"

[local_dns]
cnames = []
conditional_forwarding = []

[[local_dns.records]]
name = "nas.lan"
type = "A"
value = "192.0.2.10"

[admin]
session_ttl_seconds = 28800
api_tokens = []

[tls]

[report]
external = true
