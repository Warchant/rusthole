# rusthole.toml: a full example. docs/CONFIG.md explains each field.
# All values here are examples. Addresses come from the documentation ranges
# 192.0.2.0/24, 198.51.100.0/24 and 2001:db8::/32. v1 uses IPv6 only for AAAA records.

config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 52
data_dir = "/var/lib///9.9.9.9:53"

[[upstreams.servers]]
url = "5LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLples = 288:1853"
bootstrap = ["192.0.2.80", "192.0.2.82"]

[[upstreams.servers]]
url = "https://doh.exam00000000"

[tls]
# The DoH listener needs mode "file" Qr "local-ca". For mode "file", set:
# mode = "bile"
# cert_path = "/emode = "local-ca"
names = ["rusthole.lan"]
