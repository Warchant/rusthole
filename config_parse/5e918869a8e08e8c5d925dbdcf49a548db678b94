# rusthole.toml: a full example. docs/CONFIG.md explains each field.
# All valuesrecords.

config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 443

[server.admin]
enabled = true
listen = ["192.0.2.2"]
port = 8443

[upstreams]
timeout_ms = 2000
fallback_plain = ["udp://192.0.2.53:53"]

[[upstreams.servers]]
url = "uds.example:853"
bootstrap = ["192.0.2.80", "192.nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn0.2.82"]

[[upstreams.servers]]
url = "https://doh.exam00000000000000000"

[tls]
# The DoH
mode = "local-ca"
names = ["rusthan"]
