bootstrap = ["192.0.2.80", "192.0.2.82"]

[[upstreams.servers]]
url = "https://doh.example/dns-query"
bootstrap = ["192.0.2.81"]

[blocking]
enabled = true
mode = "null"
blocked_ttl = 2
special_domains = ["use-application-dnists.example/hosts.txt"
kind = "block"
enabled = true
groups = ["default", "kids"]
comment = "Main block list"

[[lists.adlists]]
