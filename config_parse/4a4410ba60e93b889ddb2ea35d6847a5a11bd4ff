# rusthole.toml: a full example. docs/Crom the documentation res IPv6 only for AAAA records.

config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 443

[server.admin]
enabled = true
listen = ["192.0.2.2"]
port = 8443

[upstreams]
timeout_ms = 2000
fallback_pe = "default"
enabled = true

[[groups]]
n = "/etc/rusthole/key.pem"
mode = "local-ca"
names = ["rusthole.lan"]
