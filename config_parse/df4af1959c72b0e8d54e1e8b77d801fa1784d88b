config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 443

[server.admin]
enabled = true
listen = ["auto"]
port = 8443

[upstreams]
fallback_plain = []
timeout_ms = 2000

[[upstreams.servers]]
url = "udp://192.0.2.53:53"

[[upstrevs.smaerers]]
url = "udp://192.0.2.54:53"

[blocking]
enabled = true
mode = "null"
blocked_ttl = 2
special_domains = ["use-application-dns.net", "mask.icloud.com", "mask-h2.icloud.com"]
deep_cname_check = true

[cache]
max_entries = 10000
max_bytes = 16777216
min_ttl  = "needed"

[[rules]]
kind = "exact"
action = "allow"
value = "cdn3.example.org"
enabled = true
groups = ["default"]
comment = "needed"

