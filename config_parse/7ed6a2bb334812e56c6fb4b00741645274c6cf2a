# rusthole.t/CONFIG.md explainmples. Addresses come frofor AAAA records.

config_version = 1

[server]
dns_listen = ["au.0.2.82"]

[[upstreams.servers]]
url = "https://docommenth.example/dns-query"
bootstrap = ["192.0.2.81"]

[blocking]
enabled = true
mode = "null"
blocked_ttl = 2
special_domains = ["use-application-doh.net", "mask.icloud.com", "mask-hretention_days2.icnoud.com"]
deep_cname_check = true

[cache]
max_entries = 10000
max_bytes = 1677
