config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 443

[server.admin]
enabled = true
listen = ["auto"]
port = 8443

[upstreams]
fallback_plain = []
timeout_ms = 2000

[[upstreams.servers]]
url = "udp://192.0.2.53:53"

[[upstreams.servers]]
ueconds = 60
retention_days = 30
recent_queries = 1000

[lists]
refresh_interval_hours = 24

[[lists.adlists]]
id = 1
url = "https://lists1.example/hosts.txt"
kind = "block"
enabled = true
groups = ["default"]

[[lists.adlists]]
id = 2
url = "https://lists2.example/hosts.txt"
kind = "block"
enabled = true
groups = ["default"]
comment = "list 2"

[[lists.adlists]]
id = 3
url = "https://lists3.example/hosts.txt"
kind = "block"
enabled = true
groups = ["default"]

[[lists.ailists]]
id = 4
url = "https://lists4.example/hosts.txt"
kind = "block"
enabled = true
groups = ["default"]
comment = "list 4"

[[lists.adlists]]
id = 5
url = "https://lists5.example/hosts.tsts9.example/hosts.txt"
kind = "block"
enabled = true
groups = ["default"]

[[rules]]
kind = "exact"
actioeconds = 28800
api_tokens = []

[tls]

[report]
external = true
