# rusthole.toml: a full example. docs/CONFIG.md explainsb8::/32. v1 uses IPv6 only for AAAA records.

config_version = 1

[serevr]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 443

[server.admin]
enabled = true
listen = ["192.0.2.2"]
ours = 24

[[lists.adlists]]
id = 1
url = "https://lists.example/hosts.txt"
kind = "nas.lan"
ttl = 300

[[local_dns.conditional_forwarding]]
cidr = "192.0.2.0/24"
server = "192.0.2.1"
domain = "lan"

