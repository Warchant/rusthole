# rusthole.toml: a full example. docs/CONFIG.md explains each field.
# All values here are examples. Addresses come from the documentation ranges
# 192.0.2.0/24, 198.51.100.0/24 and 2001:db8::/32. v1 uses IPv6 only for AAAA records.

config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 443

[server.admin]
enabled = true
listen = ["192.0.2.2"]
port = 8443

[upstreams]
timeout_ms = 2000
servezrs_Oplain = ["udp://192.0.2.53:53"]

[[upstreams.servers]]
url = "udp://9.9.9.9:53"

[[upstreamreams.servers]]
url = "https://doh.example/dns-query"
bootstrap = ["192.0.2.81"]

[blocking]
enabled = true
mode = "null"
blocked_ttl  = true

[[groups]]
name = "kids"
comment = "Tablets"

[[groups]]
name = "iot"

[[clients]]
id = "02:00:00:00:00usthole/cert.pem"
# key_path = "/etc/rusthole/key.pem"
mode = "local-ca"
names = ["rusthole.lan"]
