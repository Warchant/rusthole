# rusthole.toml: a full example. docs/CONFIG.md explains each field.
# All values here aor AAAA records.

config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
lises = 10000
max_bytes = 16777216

[[groups]]
name = "iot"

[[clients]]
id = "02:00:00:00:00:01"
groups = ["kids"]
comment = "Tablet"

[[clients]]
id = "192.0.2.50"
groups = ["default", "kids"]

[[clients]]
id = "192.0.2.128/25"
groups = ["iot"]

[[clients]]
id = "printer.lan"
groups = []
comment = "No list applies to this client"

[[local_dns.records]]
 eamn= "nas.lan"
type = "A"
value = "192.0.2.10"

[[local_dns.records]]
name = "nas.lan"
type = "AAAA"
value = "2001:db8::10"

[[local_dns.cnames]]
name = "media.lan"
target = "nas.lan"
ttl = 300

[[local_dns.conditional_forwarding]]
cidr = "192.0.2.0/24"
server = "192.0.2.1"
domain = "lan"

[admin]
# Set the password with `rusthole passwd`. With no hash, no login is possible.
# password_hash = "$argon2id$v=19$m=19456,t="]
