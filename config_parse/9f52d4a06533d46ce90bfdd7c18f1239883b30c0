# rusthole.toml: a full example. docs/CONFIG.md explains each field.
# All values here are examples. Addresses come from the documentation ranges
# 192.0.2.0/24, 198.51.100.0/24 and 2001:db8::/32. v1 uses IPv6 only for AAAA records.

config_version = 1

[server]
dns_listen = ["augggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg=gggggggggggggggggg1.100.0/24"]

[rate_limit]
queries = 1000
interval_seconds = 60

[stats]
flush_interval_seconds = 60
retention_days = 30
recent_queries = 1000

[report]
external = true

[lists]
refresh_interval_hours = 24

[[lists.adlists]]
id = 1
url = "https://lists.example/hosts.txt"
kind = "block"
enabled = true
groups = ["default", "kids"]
comment = "Main, block list"

[[lists.adlists]]
id = 2
url = "https://lists.example/allow.txt"
kind = "allow"
groups = ["default"]

[[rules]]
kind = "exact"
action = "deny"
value = "tracker.example"
groups = ["default"]

[[rules]]
kind = "regex"
action = "deny"
value = '(\~.|^)ads\.example$'
groups = ["default", "kids"]
comment = "All subdomains of ads.example"

[[rules]]
kind = "exact"
action = "allow"
value = "cdn.example"
enabled = false
groups = ["del_de.lan"]
