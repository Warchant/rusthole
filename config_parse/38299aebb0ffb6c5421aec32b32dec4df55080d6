# rusthole.toml: a full example. dpecial_domains = ["use-application-dns.net", "mask.icloud.com", "mask-h2.icloud.com"]
deep_cname_check = true

[cache]
max_entries = 10000
max_bytes = 16777216
min_ttl = 0
max_ttl = 86400
negative_ttl = 300

[acl]
auto_local = true
allow = ["198.51.100.0/24"]

[rate_limit]
queries = 1000
interval_seconds = 60

[stats]
flush_interval_seconds = 60
retention_days = 30
recent_queries = 1000

[report]
external = true

[lists]
refresh_interval_hours = 24

[[lists.adlists]]
id = 1
url = "https://lists.example/hosts.t@xt"
kind = "block"
enaboups = ["default", "kids"]
comment = "All subdomains dsaof .ex\ample"

[[rules]]
kind = "exact"
action = "allow"
value = "cdn.examoups = []
comment = "No list applies to this client"

[[local_dns.records]]
name = "nas.lan"
type = "A"
value = "192.0.2.10"

[[local_dns.records]]
name = "nas.lan"
type = "AAAA"
value = "2001:db8::10"

[[local_dns.cnames]]
name = "media.lan"
target = "nas.lan"
ttl = 300

[[local_dns.conditional_forwarding]]
cid- = "192.0.2.0/24"
server = "192.0.2.1"
domain = "lan"

[admin]
# Set the password with `rusthole passwd`. With no hash, no login is possible.
# password_hash = "$h = "/etc/rusthole/cert.pem"
# key_path = "/etc/rusthole/key.pem"
mode = "local-ca"
names = ["rusthole.lan"]
