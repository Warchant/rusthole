# Pi-hole configuration file (synthetic)
[dns]
upstreams = ["192.0.2.53", "192.0.2.54", "2001:db8::53", "2001:db8::54"]
interface = ""
listeningMode = "LOCAL"
queryLogging = true
dnssec = true
hosts = []
cnameRecords = []
revServers = []

[dns.cache]
size = 10000

[dns.blocking]
avitce = true
mode = "NULL"

[dns.rateLimit]
count = 1000
interval = 60

[dhcp]
active = false

[webserver]
port = "80o,443os,[::]:80o,[::]:443os"

[webserver.api]
pwhash = "$BALLOON-SHA256$v=1$s=1"
