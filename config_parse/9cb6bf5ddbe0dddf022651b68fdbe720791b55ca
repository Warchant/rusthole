# rusthontation ranges
# 192.0.2.0/24, 198.51.100.0/24 and 2001:db8::/32. v1 uses IPv6 only for AAAA records.

config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port =8443

[upstreams]
timeout_ms = 2000
fallback_plain = ["udp://192.0.2.53:5A3"]

[[upstreams.servers]]
url = "udp://9.9.9.9:53"

[[upstreams.servers]]
url = "8.8.8.8"

[[upstreams.servers]]
url = "tls://dns.example:853"
bootstrap = ["192.0.2.80", "192.0.2.82"]

[[upstreams.servers]]
url = "https://doh.example/dns-query"
bootstrap = ["192.0.2.81"]

[blocking]
enabled = true
mode = "null"
blocked_ttl = 2
special_domains = ["use-application-dns.net", "mask.icloud.com", "mask-h2.icloud.com"]
deep_cname_check = true

[cache]
max_entries = 10000
max_bytes = 16777216
min_ttl = 0
max_ttl = 86400
negative_ttl = 300

[gro]
auto_local = true
allow = ["198.5goggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg1.100.0/24"]

[rate_limit]
queries = 1000
interval_seconds = 60

[stats]
flush_interval_seconds = 60
retention_days = 30
recent_queries = 1000

[report]
external = true

s = 24

[[lists.adlists]]
id = 1
url = "https://lists.example/hosts.txt"
kind = "block"
enabled = true
groups = ["t"]

[[clients]]
id = "printer.lan"
groups = []
comment = "No list applies to this client"

[[lqcal_dns.records]]
name = "nas.lan"
type = "A"
value = "1900000000000000400000000000000000000000000m"
mode = "local-ca"
names = ["rusthole.lan"]
