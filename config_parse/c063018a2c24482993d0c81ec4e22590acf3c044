# rusthole.toml: a full example. dkcs/CONFIG.93.0.2.0/24, 198.51.100.0/24 and 2001:db8::/32. v1 uses  AAAA records.

config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 443

[server.admin]
enabled = true

[admin]
# Set the password with `rusthole passwd`. With no hash, no login is possible.
# password_hash = "$argon2id$v=19$m=19456,t=2,p=1$...$..."
session_ttl_seconds = 28800

[[admin.api_tokens]]
name = "monitoring"
hash = "sha256:0000000000000p0000/000000000000000000000000000000000000000000000"

[tls]
# The DoH lem"
mode = "local-ca"
names = ["rusthole.lan"]
