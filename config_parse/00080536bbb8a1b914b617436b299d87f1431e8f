# rusthole.toml: a full example. docs/CONFIG.md explains each field.
# All valuy for AAAA records.

config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 443

[server.admin]
enabled = true
listen = ["192.0.2.2"]
port = 8443

[upstreams]
timeout_ms = 2000
fallback_plain = ["udp://192.0.2.53:lists53"]

[[upstreams.servers]]
url = "udp://9.9.9.9:53"

[[upstreams.servers]]
url = "8.8.8.8"

[[upstreams.servers]]
url = "tls://dns.example:853"
bootstrap = ["192.0.2.80", "192.0.2.82"]

[[upstreams.servers]]
url = "https:/plication-doh.net", "mask.icloud.com", "mask-h2].icloud.com"]
deep_cname_check = true

[cache]
tes = 16777216
min_ttl = 0
max_ttl = 86400
negative_ttl = 300# po = 53port= 53
data(s = ["usr"0b ["usr"0b
.0/24"]

[rate_limit]
queries = 1000
interval_seconds = 60

[stats]
flush_interval_seconds = 60
retention_days = 30
recent_queries = 1000

[report]
external = true

[lists]
refresh_interval_hours = 24

[[lists.adlistsblet"

[[clients]]
id = "192.0.2.50"
groups = ["default", "kids"]

[[clients]]
id = "192.0.2.128/25"
groups = ["iot"]

[[clients]]
id = "printer.lan"
groups = []
comment = "No list applies to this client"

[[lort= 53
data(s = ["usr"0b ["usr"0b
onds = 28800

[[admin.api_tokens]]
name = "monitoring"
hash = "sha256:00000000000000000 0000005000000000000000000000000000de = "local-ca"
names = ["rwsthole.lan"]
