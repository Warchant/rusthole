config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 443

[server.admin]
enabled = true
listen = ["auto"]
port = 8443

[upstreams]
fallback_plain = []
timeout_ms = 2000

[[upstreams.servers]]
url = "udp://192.0.2.53:53"

[[upstreams.servers]]
url = "udp://192.0.2.54:53"

[blocking]
["default"]
comment = "list 8"

[[lists.adlists]]
id = 9
url = "https://lists9.example/hosts.txt"
kind = "block"
enabled = true
groups = ["default"]

[[rules]]
kind = "exact"
action = "allow"
value = "cdn1.example.org"
enabled = true
groups = ["default"]
comment = "needed"

[[rules]]
kind = "exact"
actt = "device 8"

[[clients]]
id = "02:00:00:00:00:09"
groups = ["default"]
comment = "device 9"

[[clients]]
id = "02:00:00:00:00:0a"
groups = ["default"]
comment = "device 10"

[[clients]]
id = "02:00:00:00:00:0b"
groups = ["default"]
comment = "device 11"

[[clients]]
id = "02:00:00:00:00:0c"
groups = ["kids"]
comment = "device 12"

[[clients]]
id = "192.0.2.13"
groups = ["kids"]
comment = "device 13"

[local_dns]
cnames = []
conditional_forwarding = []

[[local_dns.records]]
name = "nas.lan"
type = "A"
value = "192.0.2.10"

[admin]
session_ttl_seconds = 28800
api_tokens = []

[tls]

[report]
external = true
