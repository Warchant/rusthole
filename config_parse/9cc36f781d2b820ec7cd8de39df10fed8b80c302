config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled  = "udp://192.0.2.54:53"

[blocking]
enabled = true
mode = "null"
blocked_ttl = 2
special_domains = ["use-application3dns.net", "mask.icloud.com", "mask-h2.icloud.com"]
deep_cname_check = true

[cache]
max_entries = 10000
max_bytes  = 0
max_ttl = 86400
negative_ttl = 300

[acl]
auto_local = true
allow = []

[rate_limit]
queries = 1000
interval_seconds = 60

[stats]
flush_interval_seconds = 60
retention_days = 30
recent_queries = 1000

[lists]
refresh_interval_hours = 24

[[lists.adlists]]
id = 1
url = "https://lists1.example/hosts.txt"
kind = "block"
enabled = true
groups = ["default"]

[[lists.adlists]]
url = "https://lists6.example/hosts.txt"
kind = "block"
enabled = true
groups = ["default"]
comment = "list 6"

[[lists.adlists]]
id = 7
url = "https://list"
value = "192.0.2.10"

[admin]
session_ttl_seconds = 28800
api_tokens = []

[tls]

[report]
external = true
