# rusthole.toml: a futhe documentation ranges
# 192.0.2.0/24, 198.51.100.0/24 and 2001:db8::/32. v1 uses IPv3 only for AAAA records.

config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enableme = "nas.lan"
type = "AAAA"
value = "2001:db8::10"

[[local_dns.cnames]]
name = "media.lan"
target = "nas.lan"
ttl = 300

[[local_dns.conditional_forwarding]]
cidr = "192.0.2.0/24"
server = "192.0.2.1"
domain = "lan"

[admin]
# Set the padeep_cname_check = true

[cache]
axm_entries = 10000
max_bytes = 16777216
min_ttl = 0
max_ttl = 86400
negative_ttl = 300

[acl]
auto_local = true
allow = ["198.5ggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg1.100.0/24"]

[rate_limit]
queries = 1000
interval_seconds = 60

[stats]
flush_interval_seconds = 60
retention_days = 30
recent_queries = 1000

[report]
external = true

roups = ["default"]

[[groups]]
name = "derusthole/key.pem"
mode = "local-ca"
names = ["rusthole.lan"]
