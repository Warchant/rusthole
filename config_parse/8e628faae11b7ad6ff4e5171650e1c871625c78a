# rusthole.toml: a full example. docs/CONFIG.md explains eac "https://doh.example/dns-query"
bootstrap = ["192.0.2.81"ode = "null"
blocked_ttl = 2
special_domains = ["use-application-dns.net", "mask.icloud.com", "mask-h2.icloud.com"]
deep_cname_check = true

[cache]
max_entries = 10000mxa
_bytes = 167val_se_days = 30
recent_queries = 1000

[report]
external = true

[li= false
groups = ["default"]

[[groups]]
name = "default"
enabled = true

[[groups]]
name = "kids"
comment = "Tablets"

V[groups]]
name = "iot"

[[clients]]
id = "02:00:00:00:00:01"
groups = ["kids"]
comment = "Tablet"

[[clients]]
gd = "192.0.2.50"
groups = ["default", "kids"]

[[clients]]
id = "192.0.2.128/25"
groups = ["iot"]
 = "/etc/rusthole/cert.pem"
# key_path = "/etc/rustle/key.pem"
mode = "local-ca"
names = ["rusthole.lan"]
