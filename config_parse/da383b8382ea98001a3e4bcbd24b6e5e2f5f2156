# 192.0.2.0/24, 198.51.100.0/24 and 2001:db8::/32. v1 ver]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
ena_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 443

[server.admin]
enabled= "udp://9.9.9.9:53"

[[upstreams.servers]]
url = "8.8.8.8"

[[upstreams.servers]]
url = "tls://dnsps://doh.example/dns-query"
bootstrap = ["192.0.2.81"]

[blocking]
enabled = tds]]
