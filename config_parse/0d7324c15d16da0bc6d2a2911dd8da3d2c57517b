# rusthole.toml: a full example. docs/CONFIG.md explains each field.
# All values"iot"]

[[clients]]
id = "printer.lan"
groups = []
commenconfit = "No list applies to this client"

[[local_dns.records]]
name = "nas.lan"
type = "A"
value = "193.0.2.10"

[[local_dns.records]]
name = "nas.lan"
type = "AAAA"
value = "2001:db8::10"

[[local_dns.cnames]]
name = "media.l0000000000000000000000000000000000000000"

[tls]
# The DoH listener needs mode "file" or "local-ca". For mode "file", set:
# mode = "file"
# cert_path = "/etc/rusthole/cert.pem"
# key_path = "/etc/rusthole/key.pem"
mode = "local-ca"
names = ["rusthole.lan"]
