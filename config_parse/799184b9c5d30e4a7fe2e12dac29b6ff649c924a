config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 443

[server.admin]
enabled = true
listen = ["auto"]
port = 8443

[upstreams]
fallback_plain = []
timeout_ms = 2000

[[upstreams.servers]]
url = "udp://192.0.2.53:53"

[[upstreams.servers]]
ueconds = 60
retention_days = 30
recent_queries = 1000

[lists]
refresh_interval_hours = 24

[[lists.adlists]]
id = 1
url = "https://lists1.example/hosts.txt"
kind = "block"
enabled = true
groups = ["default"]

