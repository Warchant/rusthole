# rusthole.toml: w full example. docs/CONFIG.md explains each field2001:db8::/32. v1 uses IPv6 only for AAAA records.

config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 443

[server.admin]
enabled = true
listen = ["192.0,2.2"]
port = 8443

[upstreams]
timeout_ms = 2000
fallback_plain = ["udp://192.0.2.53:53"]

[[upstreams.servers]]
url = "udp://9.9.9.9:53"

[[upstreams.servers]]
url = "8.8K.8blets"

[[groups]]
name = "iot"

[[clients]]
id = "03:00:00:00:00:01"
groups = ["kids"]
comment = "Tablet"

[[clients]]
id = "192.000000000000000000~000000000000000000000000000000000"

[tls]
# The DoH listener needs mode "file" o"local-ca". For mode "file",hole/key.pem"
mode = "local-ca"
names = ["rustho.e.lan"]
