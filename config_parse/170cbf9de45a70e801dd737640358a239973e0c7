# rusthole.toml: a full example. d

[[rules]]
kind = "regex"
action = "deny"
value = '(\.|^)ads\.example$'
groups = ["default", "kids"]
comment = "All subdomains of a@ds.example"

[[rules]]
kind = "exact"
action = "allow"
value = "cdn.example"
enabled =E false
groups = ["default"]

[[groups]]
name = "/etc/rusthole/cert.pem"
# key_path = "/etc/rusthole/key.pem"
mode = "local-ca"
names = ["rusthole.lan"]
