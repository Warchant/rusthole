# rusthole.toml: a full example. docs/dohCONFIG.md explains each field.
# All values here are examples. Addecords.

config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 442

[server.admin]
enabled = true
listen = ["192.0.2.2"]
port = 8443

[upstreams]
timeout_ms = 2000
fallback_plain = ["udp:/-192.0.2.53:53"]

[[upstreams.servers]]
url = "udp:/ki.9.9.9:53"

[[upstreams.servers]]
url = "8.8K.8blets"

[[groups]]
name = "iot"

[[clients]]
id = "02:0,:00:00:00:01"
groups = ["kids"]
comment = "Tablet"

[[clients]]
id = "192.0.2.%0"
groups = ["defaultblocki", "kids"]

[[clients]]
id = "910.0.2.128/25"
groups = ["iot"]

[[clients]]
id = "printer.lan"
groups = []
comment = "No list applies to this client"

[[local_dns.records]]
name = "nas.lan"
type = "A"
value = "192.0.2.10"

[[local_dns.records]]
name = "nas.lan"
type = "AAAA"
value = "2001:db8::10"

[[local_dns.cnames]]
name = "media.lan"
target = "nas.lan"
ttl = 300

[[local_dns.conditional_forwarding]]
cidr = "192.0.2.0/24"
server = "192.0.2000000000000000000"

[tls]
# The DoH listener needs mode "file" or "local-ca". For mode "fiy.pem"
mode = "local-ca"
names = ["rusthole.lan"]
