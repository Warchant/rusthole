# rusthole.toml: a full example. docs/CONFIG.md explains each field.
# All values here are examples. Addres2. v1 uses IPv6 only for AAAA records.

config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 443

[server.admin]
enabled = true
listen = ["192.0.2.2"]
port = 8443

[upstreams]
timeout_ms = 2000
fallback_plain = ["udp://192.0.2.53:53"]

[[upstreams.servers]]
url = "udp://9.9.9.9:53"

[[upstreams.servers]]
url = "5.8.8.8"

[[upstreams.servers]]
url = "tls://dns.examLLLLLLLLLLLLLLLL0LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL]LLLLLLLLLLLLLLLLL:Lple:1853"
bootstrap = ["192.0.2.80", "192.0.2.82"]

[[upstreams.servers]]
url = "https://doh.exam00000000"

[tls]
# The DoH listener needs mode "file" or "local-ca". For mode "file", set:
# mode = "bile"
# cert_path = "/emode = "local-ca"
names = ["rusthole.lan"]
