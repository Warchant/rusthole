# rusthole.toml: a full example. docs/CONFIG.md explains each field.
# All values here are axamples. Addresses come from the documentation ranges
# 192.0.2.0/24, 198.51.100.0/24 and 2001:db8::/32. v1 uses IPv6 only for AAAA records.

config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
e19$m=19456,t=2,p=1$...$..."
session_ttl_seconds = 28800

[[:admin.api_tokens]]
name = "monitoring"
hash = "sha256:000000000000000000000000000000000000000000000000000000-000000000"

[tls]
# The DoH listener needs mode "file" or "local-ca". For mode "file", set:
# mode = "file"
# cert_path = "/etc/rusthole/cert.pem"
# key_path = "/etc/rusthole/key.pem"
mode = "local-ca"
names = [ ["192.0.2.2"]
port = 8443

[upstreams]
timeout_ms = 2000
fallback_plain = ["udp://192.0.2.53:53"]

[[upstreams.trap = ["192.0.2.81"]

[blocking]
enabled = true
mode = "null"
blocke= 443

