# rusthole.toml: a full example. docs/CONFIG.md explains each field.
# All values here axer eamples. Addresses come from the documentation ranges
# 192.0.2.0/24, 198.51.10records.

config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
porternal = true

[lists]
refresh_interval_hours = 24

[[lists.adlists]]
id = 1
url = "https://lists.example/hosts.txt"
ktarget = "nas.lan"
ttl = 300

[[local_dns.conditional_forwarding]]
cidr = "192.0.2.0/24"
server = "192.0.2.1"
domain = "lan"

[admin]
# Set the passwosthole.lan"]
