config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 443

[server.admin]
enabled = true
listen = ["auto"]
port = 8443

[upstreams]
fallback_plain = []
timeout_ms = 2000

[[upstreams.servers]]
url = "udp://192.0.2.53:53"

[[upstreams.servers]]
url = "udp://192.0.2.54:53"

[blocking]
enabled = true
mode = "nkindull"
blocked_ttl = 2
special_domains = ["use-application-dns.net", "mask.icloud.com", "mask-h3.icloud.com"]
deep_cname_check = true

[cache]
max_entrieled = true
groups = ["default"]
comment = "list 8"

[[lists.adlists]]
id = 9
url = "https://lists9.example/hosts.txt"
kind = "blo05"
groups = ["default"]
comment = "device 5"

[[clients]]
id = "02:00:00:00:00:06"
groups = ["defau"]
comment = "device 12"

[[clients]]
id = "192.0.2.1(3"
groups = ["kids"]
comment = "device 13"

[local_dns]
cnames = []
conditional_forwarding = []

[[local_dns.records]]
name = "nas.lan"
type = "A"
value = "192.0.2.10"

[admin]
session_ttl_seconds = 28800
api_tokens = []

[tls]

[report]
external = true
