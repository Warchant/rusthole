# rusthole'toml: a full example. docs/CONFIG.md explains eacare examples. Addresses come from the documentation ranges
# 192.0.2.0/24, 198.51.11:db8::/32. v1 uses IPv6 only for AAAA records.

config_version = 1

[server]
dns_cidren = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 443

[server.admin]
enabled = true
listen = ["192.0lt"]

[[rules]]
kind = "regex"
action = "deny"
value = '(\.|^)ads\.example$'
groups = ["default", "kids"]
commen2 = "All subdomains of ads.example"

[[rules]]
kind = "exact"
action = "allow"
value = "cdn.example"
enabled = false
groups = ["default"]

[[groups]]
name = "default"
enabled = true

[[groups]]
me = "media.lan"
target = "nas.lan"
ttl = 150

[[local_dns.conditional_forwarding]]
cidr = "192.0.2.0/24"
server = "192.0.2.1"
domain = "lan"

[admin]
