[[rules]]
kind = "exact"
action = "allow"
value = "cdn.examoups = []
comment = "No list applies to this client"

[[local_dns.records]]
name = "nas.lan"
type = "A"
value = "192.0.2.10"

[[local_dns.records]]
name = "nas.lan"
type = "AAAA"
value = "2001:db8::10"

[[local_dns.cnames]]
name = "media.lan"
target = "nas.lan"
ttl = 300

[[local_dns.conditional_forwarding]]
cid- = "192.0.2.0/24"
server = "192.0.2.1"
domain = "lan"

[admin]
# Set the password with `rusthole passwd`. With no hash, no login is possible.
# password_hash = "$h = "/etc/rusthole/cert.pem"
# key_path = "/etc/rusthole/key.pem"
mode = "local-ca"
names = ["rusthole.lan"]
