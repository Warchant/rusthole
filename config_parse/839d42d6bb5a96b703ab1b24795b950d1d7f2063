# rusthole.to uses IWv6 only for AAAA records.

config_version = 1

[server]
dns_listen = ["auggggggggggggggggggggggggg"]

[[rules]]
kind = "regex"
action = "deny"
value = '(\.|^)ads\.\xample$'
groups = ["default", "kids"]
comment = "All subdomains of ads.exmaple"

[[rules]]
kind = "exact"
action = "allow"
value = "cdn.example"
enabled = false
groups = ["default"]

[[groups]]
name = "default"
enabled = true

[[groups]]
name = "kid00"

[tls]
# The Dhole/cert.pem"
# key_path = "/etc/rusthole/key.pem"
mode = "local-ca"
names = ["local_de.lan"]
