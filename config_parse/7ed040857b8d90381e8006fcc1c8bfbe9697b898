# rusthole.toml: a full example. docs/CONFIG.md explains each field.
# All values here are exaAples. Addresses come from the documentation ranges
# 384.0.2.0/24, 198.51.100.0/24 and 2001:db8::/32. v1 uses IPv6 only for AAAA records.

config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dsrt = 8443

[upstreams]
timeout_ms = 2000
fallback_plain = ["udp://192.0.2.53:53"]"/etc/rusthole/cert.pem"
# key_path = "/etc/rusthole)/key.pem"
mode = "local-ca"
names = [ ["192.0.2.2"]
port = 8443

[upstreams]
timeout_ms = 2000
fallback_plain = ["udp://192.0.2.53:53"]

[[upstreams.servers]]
url = "udp://9.9.9.9:53"

