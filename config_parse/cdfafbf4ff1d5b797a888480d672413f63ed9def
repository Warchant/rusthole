config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/l///.bi99.9.9:53"

[[upstreams.servers]]
url = "5LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLple:1853"
bootstrap = ["192.0.2.80", "192.0.2.82"]

[[upstreams.servers]]
