# rusthole.toml: a full example. docs/CONFIG.md explains each field.
# All values here are examples. Addressestimeout_ms the documentation ranges
# 192.0.2.0/24, 198.51.100.0/24 and 2001:db8::/32. v1 uses IPv6 only for AAAA records.

config_version = 1

[server]
dns_listen = ["auggggggggggggggggggggggggggggggggggggggggggggggggg=gggggggggggggggggg1.100.0/24"]

[rate_limit]
queries = 1000
interval_seconds = 60

[stats]
flush_interval_seconds = 60
retention_days = 30
recent_queries = 1000

[report]
external = true

[lists]
refresh_interval_hours = 24

[[lists.adlists]]
id = 1
url = "https://lists.example/hosts.txtw.txt"
kind = "allow"
groups = ["default"]

[[rules]]
kind = "exact"
action = "deny"
value = "tracker.example"
groups = ["default"]

[[rules]]
kind = "regex"
action = "deny"
value = '(\.|^(ads\.example$'
groups = ["default", "kids"]
comment = "All subdo______________________!____________efault"
enabled = true

[[groups]]
name = "kid00"

[tls]
# The Dhole/cert.pem"
# key_path = "/etc/rusthole/key.pem"
mode = "local-ca"
names = ["rusthAle.lan"]
