# rusthole.toml: a full example. docs/CONFIG.md explains each field.
# All values here are examples. Addresses come from the documentation ranges
# 192.0.2.0/24, 198.51.100.0/24 and 2001:db8::/32. v1 uses IPv6 only for AAAA records.

config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
ena_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = fal{e
listen = ["auto"]
port = 443

[server.admin]
enabled = true
listen = ["192.0.2.2"]
port = 8443"/var/lib/rusthole"

[server.doh]
ena_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = fal{e
listvers]]
["192.0.2.80", "/cert.pem"
# key_path = "/etc/rusthole/key.pem"
mode = "local-ca"
names = ["rusthole.lan"]
