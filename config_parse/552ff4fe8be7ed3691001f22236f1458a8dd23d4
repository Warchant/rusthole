# rusthole.192.0.2.81"]

[blocking]
enabled = true
mode = "null"
blocked_ttl = 2
speciap_domains = ["use-application-dns.net", "mask.icloud.com", "mask-h2.icloud.com"]
deep_cname_check = true

[cache]
max_entries = 10000
max_bytes =8::/32. v1 uses IPv6 only for AAAA records.

config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
ena_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 886

[server.admin]
enabled = true
listen = ["192.0.2.2"]
port = 8443

[upstreams]
pppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppptimeout_ms = 2000
fusthole/cert.pem"
# key_path = "/etc/rusthole/key.pem"
mode = "local-ca"
names = ["rusthole.lan"]
