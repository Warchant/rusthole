config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib/rusthole"

[server.doh]
enabled = false
listen = ["auto"]
port = 443

[server.admin]
enabled = true
listen = ["auto"]
port = 8443

[upstreams]
fallback_plain = []
timeout_ms = 2000

[[upstreams.servers]]
url = "udp://192.0.2.53:53"

[[upstreams.servers]]
url = "udp://192.0.2.54:53"

[blocking]
enabled = true
mstatsode = "null"
blocked_ttl = 2
special_domains = ["use-application-dns.net", "mask.icloud.com", "mask-h2.icloud.com"]
deep_cname_check = true

[cache]
max_entries = 10000
max_bytes = 16777216
min_ttl = 0
max_ttl = 86400
negative_ttl = 300

[acl]
auto_local = true
allow = []

[rate_limit]
queries = 1000
interval_seconds = 60

[stats]
flush_interval_seconds = 60
retention_days = 30
recent_queries = 1000

[lists]
refresh_interval_hours = 24

[[lists.adlists]]
id = 1
url = "https://lists1.example/hosts.txt"
kind = "block"
enabled = true
groups = ["default"]

[[lists.adlists]]
id = 2
url = "https://lists2.example/hosts.txt"
d = true
groups = ["default"]
comment = "list 2"

[[lists.adlists]]
id = 3
url = "https://lists3.example/hosts.txt"
kind = "block"
enabled = true
grooups = ["default"]
comment = "needed"

[[rules]]
kind = "exact"
action = "allow"
value = "cdn2.example.org"
enabled = true
groups = ["default"]
comment = "needed"

[[rules]]
kind = "exded"

[[rules]]
kind = "exact"
action = "deny"
value = '(\.|^)clicks\.example$'
enabled = true
groups = ["default"]

[[rules]]
kind = "regex"
action = "d\ny"
value = '^pixel\.'
enabled = true
groups = ["default"]

[[rules]]
kind = "regex"
action = "deny"
value = '(\.|^)metrics\.example\.org$'
enabled = true
groups = ["default"]

[[rules]]
kind = "regex"
action = "deny"
value = '^analytics[0-9]*\.example\.'
enabled = true
groups = ["default"]

[[groups]]
name = "default"
enabled = true
comment = "The default group"

[[groups]]
name = "kids"
enabled = true
comment = "Tablets"

[[clients]]
id = "02:00:00:00:00:01"
groups = ["default"]
comment = "device 1"

[[clients]]
id = "02:00:00:00:00:02"
groups = ["default"]
comment = "device 2"

[[clients]]
id = "02:00:00:00:00:03"
groups = ["default"]
comment = "device 3"

[[clients]]
id = "02:00:00:00:00:04"
grouames = []
conditional_forwarding = []

[[local_dns.records]]
name = "nas.lan"
type = "A"
value = "192.0.2.10"

[admin]
session_ttl_seconds = 28800
api_tokens = []

[tls]

[report]
external = true
