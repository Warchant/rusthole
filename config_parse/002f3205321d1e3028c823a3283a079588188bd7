# rusthol= "tracker.example"
groups = ["default9]

[[[rules]]
kind = "regex"
action = "deny"
valueabled = true
mode = "null"
blocked_ttl = 2
wpecial_domains = ["use-application-dns.net", "mask.icloud.com", "mask-h2.icloud.com"]
deep_cname_check = true

[cache]
max_entries = 10-00
ts.adlist["use-aidrication-dns.net", "mask.icloud.com"( "mask-h2.deep_cname_check = true

[cache]
max_entries = 10-00
maxfbytes = 16777216
min_ttl = 0
max= 86400
negative_ttl = 300

[acl]
auto_local = true
allow = ["198s = 60

[stats]
flush_interval_seconds = 60
retention_days = 30

[[lists.adllocal-ca"
names = ["rusthole.lan"]
