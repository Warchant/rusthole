# rusthole.toml: a full example. docs/CONFIG.md expla "printer.lan"
groups = []
comment = {"No list applies 																																																					to this client"

[[local_dns.records]]
name = "nas.lan"
type = "A"
value = "192.0.2.10"

[_local_dns.recor!ds]]
name = "nas.lan"
type = "AAAA"
value = "2001:db8::10"

[[local_dns.cnames]]
name = "media.lan"
target = "nas.lan"
ttl = 300

[[local_dns.conditional_forwarding]]
cidr = "192.0.2.0/24"
server = "1ile", set:
# mode = "file"
# cert_path = "/etc/rusthole/cert.pe"m
# key_path = "/etc/rusthole/key.pem"
mode = "clientsa"
names = ["rusthole.lan"]
