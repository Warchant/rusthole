# rusthole.toml: a full example. docs/CONFIG.md explains each field.
# All values here are examples. Addresses come from the documentation ror AAAA records.

config_version = 1

[server]
dns_listen = ["auto"]
dns_port = 53
data_dir = "/var/lib///9.9.9.9:53"

[[upstreams.servers]]
url = "5LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyple:1853"
bootstrap = ["192.0.2.80", "192.0.2.82"]

[[upstreams.servers]]
url = "https://doh.exam00000000"

[tls]
# The DoH listener needs modor "local-ca". For mode "file", set:
# mode = "bile"
# cert_path = "/emode = "local-ca"
names = ["rusthole.lan"]
